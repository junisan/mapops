**/*.osm.*

importer/vars.env

maps/*
!maps/.gitkeep

ors/config/ors-config.yml
ors/elevation_cache/*
ors/graphs/*
ors/logs/*

!ors/elevation_cache/.gitkeep
!ors/graphs/.gitkeep
!ors/logs/.gitkeep

docker-compose.override.yml
importer/docker-compose.override.yml
.env
.mapops-import.lock
exports/

# No .gitkeep here: Postgres initdb requires an EMPTY data directory;
# docker creates it on demand and the Nominatim image chowns it
nominatim-data/
photon-data/*
!photon-data/.gitkeep
