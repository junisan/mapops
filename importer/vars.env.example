# Copy this file to importer/vars.env and set your own password:
#   cp importer/vars.env.example importer/vars.env
#   openssl rand -hex 16   # generates a password
# importer/vars.env is gitignored: never commit it.

# Nominatim (importer)
PBF_PATH=/data/map.osm.pbf
IMPORT=true
NOMINATIM_PASSWORD=CHANGE_ME

# Photon (importer) — DB_PASSWORD must match NOMINATIM_PASSWORD
DB_HOST=nominatim-importer
DB_PORT=5432
DB_NAME=nominatim
DB_USER=nominatim
DB_PASSWORD=CHANGE_ME
PHOTON_LANGUAGES=es,en,it
